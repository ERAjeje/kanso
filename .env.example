# ============================================================
# Kanso — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ============================================================
#
# COMO GERAR SECRETS:
#   JWT_SECRET:            openssl rand -base64 32
#   COUCHDB_PASSWORD:      openssl rand -base64 12
#   SCHEDULER_API_KEY:     openssl rand -base64 32
#
# ============================================================

# --- Backend ---

# Porta do servidor Go (padrão: 8080)
# PORT=8080

# URL de conexão com CouchDB (padrão: http://couchdb:5984)
# COUCHDB_URL=http://couchdb:5984

# Credenciais CouchDB
# COUCHDB_USER=admin
# COUCHDB_PASSWORD=  # OBRIGATÓRIO — gere com: openssl rand -base64 12

# Chave secreta para assinar JWTs — OBRIGATÓRIA
# JWT_SECRET=  # gere com: openssl rand -base64 32

# Google OAuth Client ID — obtido no Google Cloud Console
# GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com

# Chave para o scheduler se autenticar no endpoint /api/push/send
# SCHEDULER_API_KEY=  # gere com: openssl rand -base64 32

# Firebase Cloud Messaging (FCM v1) — service account JSON em base64
# Gere: base64 -w0 .secrets/fcm-service-account.json
# FCM_SERVICE_ACCOUNT_B64=
# FCM_PROJECT_ID=

# Caminho do certificado CA para gRPC TLS (auto-gerado por infra/certs/gen-grpc-certs.sh)
# GRPC_CA_CERT=/certs/ca.crt


# --- Frontend (prefixo VITE_) ---

# Google OAuth Client ID — mesmo valor do GOOGLE_CLIENT_ID do backend
# VITE_GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com

# URL da API (Vite proxy em dev: /api → localhost:8080)
VITE_API_URL=/api

# URL do CouchDB para PouchDB sync (via Traefik HTTPS com JWT auth)
VITE_COUCHDB_URL=https://kanso.local/db

# VAPID public key para Web Push (Firebase Console -> Cloud Messaging)
# VITE_VAPID_PUBLIC_KEY=


# --- Docker Compose ---

# As variáveis abaixo são usadas pelo docker-compose.yml
# Todas são OBRIGATÓRIAS — o compose falha se não definidas

# COUCHDB_PASSWORD=  # OBRIGATÓRIO
# JWT_SECRET=        # OBRIGATÓRIO
# GOOGLE_CLIENT_ID=  # OBRIGATÓRIO
