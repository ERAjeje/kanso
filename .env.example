# ============================================================
# Kanso — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ============================================================

# --- Backend ---

# Porta do servidor Go (padrão: 8080)
# PORT=8080

# URL de conexão com CouchDB (padrão: http://couchdb:5984)
# COUCHDB_URL=http://couchdb:5984

# Credenciais CouchDB
# COUCHDB_USER=admin
# COUCHDB_PASSWORD=admin123

# Chave secreta para assinar JWTs — troque em produção!
# JWT_SECRET=dev-secret-change-in-production

# Google OAuth Client ID — obtido no Google Cloud Console
# GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com

# Diretório para PDFs temporários (padrão: /tmp/kanso-pdf)
# PDF_TMP_DIR=/tmp/kanso-pdf

# Caminho do headless Chrome (auto-detected no container chromedp/headless-shell)
# CHROMEDP_PATH=/headless-shell/headless-shell


# --- Frontend (prefixo VITE_) ---

# Google OAuth Client ID — mesmo valor do GOOGLE_CLIENT_ID do backend
# VITE_GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com

# URL da API (usado pelo Vite proxy em dev: /api → localhost:8080)
VITE_API_URL=/api

# URL do CouchDB para PouchDB sync (usado pelo Vite proxy em dev: /db → localhost:5984)
VITE_COUCHDB_URL=/db


# --- Docker Compose ---

# As variáveis abaixo são usadas pelo docker-compose.yml
# Se não definidas, os padrões do compose serão usados

# Senha do CouchDB para o container (padrão: admin123)
# COUCHDB_PASSWORD=admin123

# Chave JWT para o container (padrão: dev-secret-change-in-production)
# JWT_SECRET=dev-secret-change-in-production

# Google Client ID para o container (padrão: dev-client-id)
# GOOGLE_CLIENT_ID=123456789-xxxxx.apps.googleusercontent.com
