; CouchDB JWT Authentication Configuration
; COPY this file to local.ini and replace with your actual secret:
;   cp local.ini.example local.ini
;   echo -n '<your-jwt-secret>' | base64
;
; WARNING: local.ini is gitignored — do NOT commit secrets.

[couchdb]
uuid = kanso-dev

[chttpd]
authentication_handlers = {chttpd_auth, jwt_authentication_handler}, {chttpd_auth, default_authentication_handler}

[jwt_auth]
required_claims = exp,iat

[jwt_keys]
hmac:_default = <base64-of-jwt-secret>
